# Railway Hobby single-service deployment
# Web + worker run in one Docker container, backed by managed external databases.

APP_ENV=production
APP_DEPLOY_TARGET=railway
APP_RUNTIME_STRICT=true
APP_MANAGED_SERVICES_REQUIRED=true
APP_SECRETS_PROVIDER=env
APP_ALLOW_ENV_SECRETS_IN_PRODUCTION=true
APP_AUTH_SECRET=replace-with-long-random-secret
SCIM_BEARER_TOKEN=replace-with-long-random-token
APP_LOOKUP_HASH_SECRET=replace-with-long-random-secret
APP_FIELD_ENCRYPTION_REQUIRED=true
APP_FIELD_ENCRYPTION_KEYS_JSON={"k1":"replace-with-base64-32-byte-key"}
APP_FIELD_ENCRYPTION_ACTIVE_KEY_ID=k1
APP_COOKIE_SECURE=true
APP_ACCESS_COOKIE_NAME=lpu_access_token
AUTH_PASSWORD_MAX_AGE_DAYS=90
AUTH_EMAIL_SUFFIXES=
STUDENT_AUTH_TURNSTILE_ENABLED=true
STUDENT_AUTH_TURNSTILE_SITE_KEY=replace-with-cloudflare-turnstile-site-key
STUDENT_AUTH_TURNSTILE_SECRET_KEY=replace-with-cloudflare-turnstile-secret-key
STUDENT_AUTH_TURNSTILE_VERIFY_TIMEOUT_SECONDS=6
APP_ENFORCE_PRIVILEGED_MFA=true
MFA_ISSUER_NAME=LPU Smart Campus
MFA_TOTP_LOGIN_DRIFT_STEPS=4
MFA_TOTP_ACTIVATION_DRIFT_STEPS=10

SQLALCHEMY_DATABASE_URL=postgresql+psycopg://smartcampus:<encoded_password>@ep-<id>-pooler.<region>.aws.neon.tech/lpu_smart?sslmode=require
POSTGRES_ADMIN_DATABASE_URL=postgresql+psycopg://smartcampus:<encoded_password>@ep-<id>.<region>.aws.neon.tech/lpu_smart?sslmode=require
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_PREFER_IPV4=true
DATABASE_HOSTADDR_PROBE_TIMEOUT_SECONDS=1.5
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_SSL_MODE=require
DATABASE_DISABLE_PREPARED_STATEMENTS=true
DATABASE_APPLICATION_NAME=lpu-smart-campus-api

MONGO_URI=mongodb+srv://<username>:<encoded_password>@cluster.<provider>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=lpu_smart
MONGO_PERSISTENCE_REQUIRED=true
MONGO_SERVER_SELECTION_TIMEOUT_MS=15000
MONGO_CONNECT_TIMEOUT_MS=10000
MONGO_SOCKET_TIMEOUT_MS=20000
MONGO_STARTUP_MAX_ATTEMPTS=10
MONGO_STARTUP_RETRY_DELAY_SECONDS=2.0
MONGO_STARTUP_STRICT=true
MONGO_STARTUP_SQL_SNAPSHOT_SYNC=false
MONGO_READ_PREFERRED=true
SERVICE_DNS_FALLBACK_ENABLED=true
SERVICE_PREFER_IPV4=true
SERVICE_DNS_NAMESERVERS=1.1.1.1,8.8.8.8
SERVICE_DNS_TIMEOUT_SECONDS=5

REDIS_URL=rediss://default:<encoded_password>@cache.<provider>.com:6379/0
REDIS_REQUIRED=true
REDIS_SSL_REQUIRED=true
REDIS_SOCKET_TIMEOUT_SECONDS=1.5
REDIS_SSL_CERT_REQS=required
REALTIME_REDIS_CHANNEL=campus:events:stream
CELERY_BROKER_URL=rediss://default:<encoded_password>@cache.<provider>.com:6379/1
CELERY_RESULT_BACKEND=rediss://default:<encoded_password>@cache.<provider>.com:6379/2
WORKER_REQUIRED=true
WORKER_ENABLE_OTP=true
WORKER_ENABLE_NOTIFICATIONS=true
WORKER_ENABLE_FACE_REVERIFY=true
WORKER_ENABLE_RECOMPUTE=true
WORKER_WAIT_FOR_OTP_RESULT=true
WORKER_INLINE_FALLBACK_ENABLED=false
WORKER_STARTUP_MAX_ATTEMPTS=12
WORKER_STARTUP_RETRY_DELAY_SECONDS=2.0
WORKER_STARTUP_PING_TIMEOUT_SECONDS=2.0

# Attendance Recovery Copilot Autopilot
ATTENDANCE_RECOVERY_ENABLED=true
ATTENDANCE_RECOVERY_PARENT_ALERTS_ENABLED=true
ATTENDANCE_RECOVERY_WATCH_THRESHOLD=75
ATTENDANCE_RECOVERY_HIGH_THRESHOLD=65
ATTENDANCE_RECOVERY_CRITICAL_THRESHOLD=50
ATTENDANCE_RECOVERY_DUE_DAYS=5
ATTENDANCE_RECOVERY_WATCH_CONSECUTIVE_ABSENCES=2
ATTENDANCE_RECOVERY_HIGH_CONSECUTIVE_ABSENCES=3
ATTENDANCE_RECOVERY_CRITICAL_CONSECUTIVE_ABSENCES=4
ATTENDANCE_RECOVERY_MIN_DELIVERED_CLASSES=2
ATTENDANCE_RECOVERY_AUTOPILOT_ENABLED=true
ATTENDANCE_RECOVERY_AUTOPILOT_INTERVAL_SECONDS=900
ATTENDANCE_RECOVERY_AUTOPILOT_BATCH_SIZE=400
ATTENDANCE_RECOVERY_RETRO_NOTIFY_COOLDOWN_MINUTES=1440
ATTENDANCE_RECOVERY_AI_GUIDANCE_ENABLED=true
ATTENDANCE_RECOVERY_STUDENT_EMAIL_COOLDOWN_MINUTES=1440
ATTENDANCE_RECOVERY_FACULTY_EMAIL_COOLDOWN_MINUTES=1440

# Amazon Bedrock API key (bearer token). Store as Railway variable, not in git.
# AWS_BEARER_TOKEN_BEDROCK=ABSK...
# Campus Copilot provider
# COPILOT_LLM_ENABLED=true
# COPILOT_LLM_PROVIDER=bedrock
# COPILOT_BEDROCK_REGION=us-east-1
# COPILOT_BEDROCK_MODEL_ID=us.anthropic.claude-3-5-haiku-20241022-v1:0
# Recovery Copilot AI mail personalization
# RECOVERY_LLM_EMAIL_ENABLED=true
# RECOVERY_LLM_PROVIDER=bedrock
# RECOVERY_LLM_REQUIRED=false
# RECOVERY_BEDROCK_REGION=us-east-1
# RECOVERY_BEDROCK_MODEL_ID=us.anthropic.claude-3-5-haiku-20241022-v1:0

OTP_DELIVERY_MODE=smtp
OTP_VERIFY_CONNECTION_ON_STARTUP=true
OTP_SMTP_HOST=smtp.gmail.com
OTP_SMTP_PORT=587
OTP_SMTP_USERNAME=your_sender_gmail@gmail.com
# Google App Password (16 chars). Set in Railway variables; do not commit the real value.
OTP_SMTP_PASSWORD=your_gmail_app_password
OTP_SMTP_STARTTLS=true
OTP_SMTP_USE_SSL=false
OTP_FROM_EMAIL=your_sender_gmail@gmail.com
OTP_SUBJECT_PREFIX=LPU Smart Campus

# SendGrid is temporarily disabled until the deployment is stable.
# Keep these for later, but comment them out so SMTP is the only delivery path.
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=your_sender_gmail@gmail.com
# SENDGRID_FROM_NAME=LPU Smart Campus
# SENDGRID_API_BASE_URL=https://api.sendgrid.com

LOG_LEVEL=INFO
ALLOW_DEMO_SEED=false
